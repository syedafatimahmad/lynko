rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Secure all inspector data under their authenticated UID
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Project inspection records
      match /projects/{projectId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Individual samples
      match /samples/{sampleId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Current active Chain of Custody form state
      match /cocData/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Submitted CoC dispatch records
      match /submissions/{submissionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Default: Block all unauthorized public access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
