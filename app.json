{
  "expo": {
    "name": "Lynko",
    "slug": "lynko",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lynko.app"
    },
    "android": {
      "package": "com.lynko.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Lynko to access your camera to take project site and inspection photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Lynko to access your photo library to attach site photos to Chain of Custody."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9594429d-adf7-4faa-8d1e-bae89db88005"
      }
    }
  }
}
